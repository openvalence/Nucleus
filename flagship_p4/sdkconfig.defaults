# flagship_p4 sdkconfig.defaults -- HAND-WRITTEN and tracked. The generated
# sdkconfig.flagship_p4 derives from this and is gitignored. Edit here only.

# The stamp carries 16 MB; the generic esp32-p4 board manifest says 4 MB.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# CONFIG_ESPTOOLPY_FLASHSIZE_4MB is not set

# THIS STAMP IS ECO2 ENGINEERING SILICON (ROM says esp32p4-eco2), i.e. pre
# rev 3.0. Nothing in the board manifest tells the IDF that, and its default is
# rev >= 3.01: heap/port/esp32p4/memory_layout.c then takes the rev-3 branch and
# the link dies on _data_start/_heap_start/_bss_*, which only the rev-3 linker
# script defines. Same fact as 'board = esp32-p4, not esp32-p4_r3' in
# platformio.ini; this is its IDF-side home. Values are the ones Arduino's
# esp32p4_es libs ship, which linked and ran on this board 2026-09-20.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_1=y
# CONFIG_ESP32P4_REV_MIN_301 is not set

# The LP core emitter in ulp/. RESERVE_MEM is the IDF example's own value.
CONFIG_ULP_COPROC_ENABLED=y
CONFIG_ULP_COPROC_TYPE_LP_CORE=y
CONFIG_ULP_COPROC_RESERVE_MEM=8128

# -O2, never -Os: esp-idf's riscv memcpy/memmove/strcpy carry
# '#error ... DIG-694' behind #ifdef __OPTIMIZE_SIZE__ (silicon erratum: at
# least two instructions between a lw and the sw of that register). A
# size-optimized P4 build cannot compile newlib at all.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# CONFIG_COMPILER_OPTIMIZATION_SIZE is not set

# The stamp's only console is USB-Serial/JTAG.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set

# The LP core's clock is RTC_FAST. The IDF default is the internal RC
# oscillator: MEASURED 16.60 MHz on this stamp (HP-timed, 2026-09-20), a value
# that varies part-to-part and drifts with temperature. An emitter that
# schedules edges in mcycle needs a crystal-derived clock. XTAL here:
# MEASURED 40.00 MHz, exactly 50,000 edges per 5 s at 4000 cycles/edge,
# late=0 (2026-09-20). The sleep-power drawback in the Kconfig help does
# not apply to an always-on motion controller.
CONFIG_RTC_FAST_CLK_SRC_XTAL=y
# CONFIG_RTC_FAST_CLK_SRC_RC_FAST is not set

# C6 radio over esp_hosted. The Stamp-AddOn C6 sits on the Stamp-P4's 20-pin
# SDIO 3.0 header; pins from M5's own Arduino example (docs.m5stack.com
# /en/arduino/m5stampp4/wifi). Bus width, clock, slot and reset polarity are
# the values Arduino's esp32p4_es libs ship, which that example runs on; only
# the pin numbers differ (theirs are the Espressif dev board's).
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_STREAMING_MODE=y
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=43
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=44
CONFIG_ESP_HOSTED_SDIO_PIN_D0=45
CONFIG_ESP_HOSTED_SDIO_PIN_D1=46
CONFIG_ESP_HOSTED_SDIO_PIN_D2=47
CONFIG_ESP_HOSTED_SDIO_PIN_D3=48
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=42
# The public ESP_HOSTED_SDIO_PIN_* ints are DERIVED from these per-slot
# symbols; setting only the public ones is silently ignored (measured: the
# bus came up on 18/19/14-17 and timed out forty times). These are the ones
# that carry the value.
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=43
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=44
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=45
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=46
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=47
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=48

CONFIG_FREERTOS_HZ=1000

# app_main's stack. RAISED 3,584 -> 6,144 ON A MEASUREMENT: under the val-091.9
# workload the deepest free was 796 B of 3,584, 22 % headroom [verified
# 2026-09-21 -- uxTaskGetStackHighWaterMark, COM15]. app_main is not a parked
# task here -- it runs the whole boot sequence (parlio, LP core, esp_hosted
# WiFi bring-up, hubBegin, motionBegin) and then owns the 5 s liveness loop
# forever, so its deep path is boot and boot is the path least often re-walked
# on a bench. T21's ban is on sizing DOWN without a mark; this is the other
# direction. Costs 2,560 B of internal heap. Not a memory-map change (the main
# task stack is allocated at startup, not linked), so no clean build.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# The stamp is an ESP32-P4NRW32: 32 MB of hex-mode PSRAM. Mode and speed are
# Arduino's prebuilt esp32p4_es sdkconfig
# (framework-arduinoespressif32-libs/esp32p4_es/sdkconfig: CONFIG_SPIRAM_MODE_HEX,
# CONFIG_SPIRAM_SPEED_200M), which runs on this silicon. Both are also the IDF
# 5.5.4 defaults; stated anyway so a default change cannot move this board
# silently. 250 MHz is unreachable here: its Kconfig depends on
# !ESP32P4_SELECTS_REV_LESS_V3, and this stamp is ECO2 (see above).
# THIS BLOCK MOVES THE MEMORY MAP: clean build, delete .pio (platformio.ini
# trap 1).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Allocations at or below this size go to internal RAM unconditionally. 4096 is
# both Arduino's esp32p4_es value and the S3 product's, and it is the ceiling a
# heap census reasons against: nothing smaller can ever land in PSRAM.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# Internal RAM held back from malloc() so DMA- and internal-only allocations
# cannot be starved by PSRAM-eligible traffic. 32768 is the IDF default and the
# value the S3 product runs; Arduino's 0 suits a demo image, not a controller
# whose DMA descriptors and ISR buffers must be internal. Do not lower it
# without a measured internal maxblock.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# The SlopSync hub's WS transport rides esp_http_server. Without this,
# httpd_uri_t carries no is_websocket/supported_subprotocol fields at all and
# the handler registration does not compile. Not a memory-map change, so no
# clean-build ceremony (platformio.ini trap 1).
CONFIG_HTTPD_WS_SUPPORT=y

